{
  "name": "portfolio-cv-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Unit tests for the static portfolio CV (index.html + assets/css/styles.css)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/index.html.test.js tests/assets.test.js tests/styles.test.js tests/dom.test.js",
    "test:all": "node --test tests/index.html.test.js tests/assets.test.js tests/styles.test.js tests/dom.test.js tests/browser.test.js",
    "test:browser": "node --test tests/browser.test.js",
    "test:watch": "node --test --watch tests/index.html.test.js tests/assets.test.js tests/styles.test.js tests/dom.test.js",
    "test:install": "node tests/helpers/_install-deps.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1"
  },
  "devDependenciesOptional": {
    "playwright-core": "^1.64.1"
  }
}
